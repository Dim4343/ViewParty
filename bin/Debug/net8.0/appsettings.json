{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "download-video-api-route": {
        "ClusterId": "download-video-cluster",
        "Match": {
          "Path": "/download-video",
          "Methods": [ "POST"]
        }
      },
      "downloaded-videos-files-route": {
        "ClusterId": "download-video-cluster",
        "Match": {
          "Path": "/videos/{**catch-all}"
        },
        "Order": 1
      }
    },
    "Clusters": {
      "download-video-cluster": {
        "Destinations": {
          "node-downloader-service": {
            "Address": "http://localhost:3000/"
          }
        }
      }
    }
  }
}
